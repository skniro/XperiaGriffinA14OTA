#!/sbin/sh
# A-only OTA updater-script for Sony Xperia 5 (J9110 / Griffin)
# Never switches A/B active slot; system_b is dedicated to /product.

OUTFD="$2"
ZIPFILE="$3"
BYNAME="/dev/block/bootdevice/by-name"
WORKDIR="/tmp/ota_work"

ui_print() {
  echo "ui_print $1" > "/proc/self/fd/$OUTFD"
  echo "ui_print" > "/proc/self/fd/$OUTFD"
}

abort() {
  ui_print "ERROR: $1"
  rm -rf "$WORKDIR"
  exit 1
}

select_workdir() {
  mount /data 2>/dev/null || true
  if mkdir -p /data/ota_work 2>/dev/null; then
    local free_kb
    free_kb="$(df -k /data/ota_work 2>/dev/null | awk 'NR==2 {print $4}')"
    if [ -n "$free_kb" ] && [ "$free_kb" -ge 4718592 ] 2>/dev/null; then
      WORKDIR="/data/ota_work"
      USE_DISK_STAGING=1
      return 0
    fi
    rmdir /data/ota_work 2>/dev/null || true
  fi
  WORKDIR="/tmp/ota_work"
  USE_DISK_STAGING=0
  mkdir -p "$WORKDIR" || abort "Failed creating $WORKDIR"
}

unmount_target() {
  local blk="$1"
  local label="$2"
  local realblk mp
  realblk="$(readlink -f "$blk" 2>/dev/null || echo "$blk")"
  for mp in /system_root /system /system_ext /product /vendor /oem; do
    umount "$mp" 2>/dev/null || umount -f "$mp" 2>/dev/null || true
  done
  while read -r dev mnt _rest; do
    if [ "$dev" = "$blk" ] || [ "$dev" = "$realblk" ]; then
      ui_print "Unmounting $mnt ($label) ..."
      umount "$mnt" 2>/dev/null || umount -f "$mnt" 2>/dev/null || true
    fi
  done < /proc/mounts
}

check_block_size() {
  local img_path="$1"
  local blk="$2"
  local img_bytes blk_bytes
  img_bytes="$(wc -c < "$img_path" 2>/dev/null || echo 0)"
  blk_bytes="$(blockdev --getsize64 "$blk" 2>/dev/null || echo 0)"
  if [ "$blk_bytes" -gt 0 ] 2>/dev/null && [ "$img_bytes" -gt "$blk_bytes" ] 2>/dev/null; then
    abort "$img_path ($img_bytes B) exceeds partition size ($blk_bytes B)"
  fi
}

flash_partition() {
  local part="$1"
  local part_name="$2"
  local blk="$BYNAME/$part_name"
  local gz_entry="${part}.img.gz"
  local raw_entry="${part}.img"

  if echo "$ENTRIES" | grep -qx "$gz_entry"; then
    [ -e "$blk" ] || abort "Missing block device: $blk"
    ui_print "Extracting $gz_entry ..."
    unzip -oq "$ZIPFILE" "$gz_entry" -d "$WORKDIR" || abort "Failed extracting $gz_entry"
    unmount_target "$blk" "$part_name"
    if [ "$USE_DISK_STAGING" = "1" ]; then
      ui_print "Decompressing $gz_entry ..."
      gzip -df "$WORKDIR/$gz_entry" || abort "Corrupt gzip stream: $gz_entry"
      check_block_size "$WORKDIR/$raw_entry" "$blk"
      ui_print "Flashing $raw_entry -> $part_name ..."
      dd if="$WORKDIR/$raw_entry" of="$blk" bs=1048576 conv=fsync || abort "Failed flashing $raw_entry to $part_name"
      rm -f "$WORKDIR/$raw_entry"
    else
      ui_print "Streaming $gz_entry -> $part_name ..."
      gzip -dc "$WORKDIR/$gz_entry" > "$blk" || abort "Failed streaming $gz_entry to $part_name"
      rm -f "$WORKDIR/$gz_entry"
    fi
    sync
    return 0
  fi

  if echo "$ENTRIES" | grep -qx "$raw_entry"; then
    [ -e "$blk" ] || abort "Missing block device: $blk"
    ui_print "Extracting $raw_entry ..."
    unzip -oq "$ZIPFILE" "$raw_entry" -d "$WORKDIR" || abort "Failed extracting $raw_entry"
    check_block_size "$WORKDIR/$raw_entry" "$blk"
    unmount_target "$blk" "$part_name"
    ui_print "Flashing $raw_entry -> $part_name ..."
    dd if="$WORKDIR/$raw_entry" of="$blk" bs=1048576 conv=fsync || abort "Failed flashing $raw_entry to $part_name"
    sync
    rm -f "$WORKDIR/$raw_entry"
    return 0
  fi
}

ui_print "========================================"
ui_print " Xperia 5 (J9110) A-only OTA Installer"
ui_print "========================================"

SLOT="$(getprop ro.boot.slot_suffix)"
[ -z "$SLOT" ] && SLOT="_a"
[ "$SLOT" = "_a" ] || abort "Unexpected active slot '$SLOT' (expected _a)"

rm -rf /data/ota_work /tmp/ota_work
select_workdir
ui_print "Workdir: $WORKDIR (staging=$USE_DISK_STAGING)"

# ziptool provides zipinfo (-1) and unzip (-oq); never use Info-ZIP -Z1
ENTRIES="$(zipinfo -1 "$ZIPFILE" 2>/dev/null)" || abort "Failed reading zip entries"

# Safety guard: refuse any A/B payload package
echo "$ENTRIES" | grep -qx "payload.bin" && abort "Refusing A/B payload.bin on A-only layout"

flash_partition system  system_a
flash_partition product system_b
flash_partition vendor  vendor_a
flash_partition oem     oem_a
flash_partition boot    boot_a
flash_partition dtbo    dtbo_a
flash_partition vbmeta  vbmeta_a

mkdir -p /cache/recovery/fota
# Write 4-byte 0x00000000 status for UpdateCenter FirmwareInstaller.readStatusFile()
printf '\x00\x00\x00\x00' > /cache/recovery/fota/status

rm -rf "$WORKDIR"
ui_print "A-only OTA installation completed successfully."
exit 0
